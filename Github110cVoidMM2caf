local function getMyRole()
    local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
    if not remote then return "Default" end
    local success, data = pcall(remote.InvokeServer, remote)
    if not success or type(data) ~= "table" then return "Default" end
    local myData = data[player.Name]
    if myData and type(myData) == "table" and not myData.Dead then
        return myData.Role or "Default"
    end
    return "Default"
end

local function onBagFull()
    if not resetWhenFullEnabled then bagFullProcessing = false; return end
    bagFullProcessing = true
    if player.Character then player.Character:BreakJoints() end
    player.CharacterAdded:Wait()
    task.wait(1)
    updateHRP()
    task.wait(1)
    bagFullProcessing = false
end

task.spawn(function()
    while true do
        task.wait(0.75)
        if resetWhenFullEnabled and getMyRole() == "Default" then
            currentCandies = 0
        end
    end
end)

local function getNearestCandy()
    if not hrp then return nil end
    if currentCandies >= maxCandies then return nil end

    local pos = hrp.Position
    local best, bestDist = nil, 9e9

    for _, map in Workspace:GetChildren() do
        local folder = map:FindFirstChild("CoinContainer")
        if folder then
            for _, obj in folder:GetChildren() do
                if obj:IsA("BasePart")
                    and obj:GetAttribute("CoinID") == "Candy"
                    and obj:FindFirstChild("TouchInterest")
                    and not collectedCandies[obj]
                then
                    local d = (pos - obj.Position).Magnitude
                    if d < 500 and d < bestDist and d > 3 then
                        bestDist = d
                        best = obj
                    end
                end
            end
        end
    end
    return best
end

local function startFarming()
    while farmEnabled do
        if bagFullProcessing or currentCandies >= maxCandies then
            task.wait(1)
            continue
        end
        if not hrp or not player.Character or (humanoid and humanoid.Health <= 0) then
            task.wait(0.5)
            continue
        end
        local candy = getNearestCandy()
        if candy then
            collectedCandies[candy] = true
            local candyPos = candy.Position
            local dist = (hrp.Position - candyPos).Magnitude
            local goal = CFrame.new(candyPos + Vector3.new(0, 3, 0))
            local time = math.max(dist / speed, 0.03)
            local tween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = goal})
            tween:Play()
            local candyStillValid = true
            while tween.PlaybackState == Enum.PlaybackState.Playing and candyStillValid do
                if not candy.Parent or not candy:FindFirstChild("TouchInterest") then
                    candyStillValid = false
                    tween:Cancel()
                end
                task.wait(0.1)
            end
        else
            task.wait(0.2)
        end
    end
end

if candyCollectedRemote then
    candyCollectedRemote.OnClientEvent:Connect(function(itemType, amount)
        if itemType == "Candy" then
            currentCandies = amount
            if currentCandies >= maxCandies and not bagFullProcessing and resetWhenFullEnabled then
                bagFullProcessing = true
                task.spawn(onBagFull)
            end
        end
    end)
end

if roundStartRemote then
    roundStartRemote.OnClientEvent:Connect(function()
        collectedCandies = {}
        currentCandies = 0
    end)
end

