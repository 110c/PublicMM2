watermark.TextColor3 = Color3.new(1, 1, 1)
watermark.TextStrokeColor3 = F_ACCENT
watermark.TextStrokeTransparency = 0
watermark.Font = Enum.Font.GothamBold
watermark.TextSize = 11
watermark.TextXAlignment = Enum.TextXAlignment.Right
watermark.ZIndex = 4
watermark.Parent = main

local function refreshStatus()
    if farmEnabled then
        statusDot.BackgroundColor3 = F_ACCENT
        statusLabel.Text = string.format("Farm: ON | Speed: %.1f", speed)
    else
        statusDot.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
        statusLabel.Text = string.format("Farm: OFF | Speed: %.1f", speed)
    end
end

local function refreshFarmBtn()
    if farmEnabled then
        farmToggle.Text = "FARM: ON"
        farmToggle.BackgroundColor3 = F_BG_MID:Lerp(F_ACCENT, 0.3)
        fts.Color = F_ACCENT; fts.Transparency = 0
    else
        farmToggle.Text = "FARM: OFF"
        farmToggle.BackgroundColor3 = F_BG_MID
        fts.Color = F_ACCENT_DK; fts.Transparency = 0.2
    end
end

local function refreshResetCard()
    if resetWhenFullEnabled then
        resetCard.BackgroundColor3 = F_BG_MID:Lerp(F_ACCENT, 0.28)
        rs.Color = F_ACCENT; rs.Transparency = 0
        resetIndicator.BackgroundColor3 = F_ACCENT
    else
        resetCard.BackgroundColor3 = F_BG_MID
        rs.Color = F_ACCENT_DK; rs.Transparency = 0.2
        resetIndicator.BackgroundColor3 = Color3.fromRGB(70, 70, 80)
    end
end

farmToggle.Activated:Connect(function()
    farmEnabled = not farmEnabled
    refreshFarmBtn()
    refreshStatus()
    if farmEnabled then
        collectedCandies = {}
        if farmLoop then task.cancel(farmLoop) end
        farmLoop = task.spawn(startFarming)
    else
        if farmLoop then task.cancel(farmLoop) end
        farmLoop = nil
    end
end)

resetCard.Activated:Connect(function()
    resetWhenFullEnabled = not resetWhenFullEnabled
    refreshResetCard()
end)

speedBox.FocusLost:Connect(function()
    local num = tonumber(speedBox.Text)
    if num then
        num = math.clamp(num, 16, 22)
        num = math.round(num * 10) / 10
        speed = num
        speedBox.Text = string.format("%.1f", num)
    else
        speedBox.Text = string.format("%.1f", speed)
    end
    refreshStatus()
end)

refreshFarmBtn()
refreshResetCard()
refreshStatus()

local dragging, dragStart, startPos = false, nil, nil
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + d.X,
            startPos.Y.Scale, startPos.Y.Offset + d.Y
        )
    end
end)
